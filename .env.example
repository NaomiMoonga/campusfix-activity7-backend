# Copy this file to .env and add your own PostgreSQL connection URL.
DATABASE_URL=postgresql://username:password@localhost:5432/campusfix
# Set true if your database provider requires SSL (Render PostgreSQL usually does).
DATABASE_SSL=false
PORT=3000
# Comma-separated allowed frontend origins; leave blank to allow requests during API testing.
CLIENT_ORIGINS=
STUDENT_NAME=Your Name
STUDENT_NUMBER=Your Student Number
